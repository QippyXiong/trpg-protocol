{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trpg-protocol:0.1.0:action",
  "title": "PreparedAction",
  "type": "object",
  "required": [
    "game_id",
    "round_no",
    "text",
    "check_id",
    "kind",
    "request_id"
  ],
  "properties": {
    "game_id": {
      "type": "integer",
      "minimum": 1
    },
    "round_no": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "const": "action"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "take_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
