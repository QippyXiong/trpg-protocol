{
  "name": "@qippyxiong/trpg-protocol",
  "version": "0.1.1",
  "description": "Versioned transport contracts for TRPG server and clients",
  "type": "module",
  "main": "./dist/routes.js",
  "types": "./dist/routes.d.ts",
  "exports": {
    ".": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./contract.json": "./dist/contract.json",
    "./browser": "./dist/protocol.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit.mjs",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QippyXiong/trpg-protocol.git"
  }
}
