{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trpg-protocol:0.1.0:event",
  "title": "RoomEvent",
  "type": "object",
  "required": [
    "id",
    "ts",
    "username",
    "display",
    "kind",
    "body"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "number"
    },
    "username": {
      "type": "string"
    },
    "display": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "action",
        "chat",
        "settlement",
        "dice",
        "system",
        "opening",
        "state_change",
        "item_change",
        "item_intent",
        "item_found",
        "objective_change",
        "turn_started",
        "turn_skipped",
        "turn_order",
        "turn_order_reveal",
        "final",
        "retraction",
        "private_choice",
        "review",
        "round_timeout",
        "moderation"
      ]
    },
    "body": {
      "type": "string"
    },
    "visibility": {
      "enum": [
        "public",
        "private",
        "after_review"
      ]
    },
    "recipient": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "game_id": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
